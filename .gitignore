# 忽略 data 目录下的所有文件
data/
data/*

# 忽略 output 目录下的所有文件
output/
output/*

# 忽略所有.csv文件
*.csv

# 忽略所有.xlsx文件
*.xlsx

# 忽略所有.nc文件
*.nc

figure/
figure/** - Copy*
.cursor/
__pycache__/
*.pyc
*.log

# 环境变量文件（包含API密钥）
.env
.env.local


# 忽略 Supplymentary 目录下的子目录和文件
Supplymentary/Supplymentary_figure/
Supplymentary/Supplymentary/
Supplymentary/ML_sensitivity/

# 也忽略其下的所有PDF和PNG文件
Supplymentary/**/*.pdf
Supplymentary/**/*.png

