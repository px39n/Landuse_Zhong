{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current semantic diagnosis submission",
  "type": "object",
  "required": [
    "receipt_ref",
    "result"
  ],
  "additionalProperties": false,
  "properties": {
    "receipt_ref": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string"
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
